# Copy to .env or run: uv run --project backend python scripts/generate_local_secrets.py
# Never commit the generated values.
OPENSEARCH_ADMIN_USERNAME=admin
OPENSEARCH_ADMIN_PASSWORD=replace-with-strong-local-password
OPENSEARCH_API_USERNAME=aiops-api
OPENSEARCH_API_PASSWORD=replace-with-strong-local-password
OPENSEARCH_DATA_PREPPER_USERNAME=data-prepper
OPENSEARCH_DATA_PREPPER_PASSWORD=replace-with-strong-local-password
OPENSEARCH_WORKER_USERNAME=aiops-worker
OPENSEARCH_WORKER_PASSWORD=replace-with-strong-local-password

# Phase 2 demo controls (non-secret). Faults remain off unless explicitly enabled.
FAULT_INJECTION_ENABLED=false
FAULT_MAX_DURATION_SECONDS=60
DEMO_HTTP_TIMEOUT_SECONDS=2
LOAD_REQUESTS_PER_SECOND=2
LOAD_DURATION_SECONDS=30
LOAD_HTTP_TIMEOUT_SECONDS=3
LOAD_SCENARIO=normal
FAULT_DURATION_SECONDS=10
FAULT_LATENCY_MS=750

# Phase 3 real application telemetry identity and Collector export.
OTEL_SERVICE_NAMESPACE=demo-shop
DEMO_SERVICE_VERSION=0.3.0
DEPLOYMENT_ENVIRONMENT=development

# Phase 5 aggregation and native anomaly-detection timing.
AGGREGATION_COMPLETENESS_DELAY_SECONDS=90
AGGREGATION_POLL_SECONDS=10
AGGREGATION_MINIMUM_SAMPLES=20
DETECTOR_WINDOW_DELAY_MINUTES=3

# Phase 6 deterministic incident worker. Fixture ingestion is opt-in and local-only.
INCIDENT_POLL_SECONDS=10
ALLOW_DEVELOPMENT_FIXTURES=false
